const AG_STORAGE_KEY = 'highlife_crm_agencies';

function loadAgencies() {
  try {
    const data = JSON.parse(localStorage.getItem(AG_STORAGE_KEY)) || [];
    // Migrate legacy status casing ("New" → "new") so kanban columns match
    let migrated = 0;
    for (const a of data) {
      const s = a.status || '';
      const norm = s.toLowerCase().replace(/[ -]/g, '_');
      if (s !== norm) { a.status = norm; migrated++; }
    }
    if (migrated > 0) localStorage.setItem(AG_STORAGE_KEY, JSON.stringify(data));
    return data;
  } catch { return []; }
}
function saveAgencies(data) {
  localStorage.setItem(AG_STORAGE_KEY, JSON.stringify(data));
}

// Statuses past "called" count as calls made
const AG_CALLED_STATUSES = ['called','left_voicemail','emailed','linkedin_messaged','interested','follow_up','partner_discussion','closed_partner'];

/* ── Agency Seed Data ── */
async function loadAgencySeedData() {
  try {
    const res = await fetch('agencies.json');
    if (!res.ok) return;
    const seed = await res.json();
    if (!Array.isArray(seed) || seed.length === 0) return;
    const existing = loadAgencies();
    const existingById = new Map(existing.map(a => [a.id, a]));
    let added = 0;
    seed.forEach(a => {
      if (!existingById.has(a.id)) {
        existing.push(a);
        added++;
      }
    });
    if (added > 0) {
      saveAgencies(existing);
      if (currentView === 'agency') renderAgencyBoard();
    }
  } catch (e) {}
}

