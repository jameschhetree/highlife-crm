/* ══════════════════════════════════════════════════════════════
   PASTE TO CLAY PANEL
   ══════════════════════════════════════════════════════════════ */
function getClayProspects() {
  const prospects = loadProspects();
  const now = new Date();
  const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);

  return prospects.filter(p => {
    if (!p.name || !p.name.trim()) return false;
    if (p.pushedToClay === true) return false;

    // createdAt within last 7 days
    if (!p.createdAt) return false;
    const created = new Date(p.createdAt);
    if (isNaN(created.getTime()) || created < sevenDaysAgo) return false;

    // At least one URL field present
    const hasUrl = (p.linkedin && p.linkedin.trim()) ||
                   (p.instagram && p.instagram.trim()) ||
                   (p.website && p.website.trim()) ||
                   (p.twitter && p.twitter.trim());
    return !!hasUrl;
  });
}

function formatClayLine(p) {
  const parts = [p.name.trim()];
  if (p.linkedin && p.linkedin.trim()) parts.push(p.linkedin.trim());
  if (p.instagram && p.instagram.trim()) parts.push(p.instagram.trim());
  if (p.website && p.website.trim()) {
    parts.push(p.website.trim());
  } else if (p.twitter && p.twitter.trim()) {
    parts.push(p.twitter.trim());
  }
  return parts.join(' - ');
}

function refreshClayPanel() {
  const clayProspects = getClayProspects();
  const contentEl = document.getElementById('clayContent');
  const actionsEl = document.getElementById('clayActions');
  const hintEl = document.getElementById('clayHint');
  const countEl = document.getElementById('clayCount');

  countEl.textContent = clayProspects.length;

  if (clayProspects.length === 0) {
    contentEl.innerHTML = '<div class="clay-empty">All caught up -- no new prospects to push</div>';
    actionsEl.style.display = 'none';
    hintEl.style.display = 'none';
  } else {
    const text = clayProspects.map(formatClayLine).join('\n');
    contentEl.innerHTML = '<textarea class="clay-textarea" readonly id="clayTextarea" rows="' +
      Math.min(Math.max(clayProspects.length, 8), 12) + '">' + esc(text) + '</textarea>';
    actionsEl.style.display = 'flex';
    hintEl.style.display = 'block';
  }
}

function updateClayCount() {
  const clayProspects = getClayProspects();
  document.getElementById('clayCount').textContent = clayProspects.length;
}

function toggleClayPanel() {
  const panel = document.getElementById('clayPanel');
  const trigger = document.getElementById('clayPanelTrigger');
  const isOpen = panel.classList.contains('visible');
  if (isOpen) {
    panel.classList.remove('visible');
    trigger.classList.remove('open');
  } else {
    panel.classList.add('visible');
    trigger.classList.add('open');
    refreshClayPanel();
  }
}

function copyClayToClipboard() {
  const ta = document.getElementById('clayTextarea');
  if (!ta) return;
  const text = ta.value;
  const lineCount = text.split('\n').filter(l => l.trim()).length;
  navigator.clipboard.writeText(text).then(() => {
    toast('Copied ' + lineCount + ' rows to clipboard');
  });
}

function copyForClay(id) {
  const prospects = loadProspects();
  const p = prospects.find(x => x.id === id);
  if (!p) return;
  const line = formatClayLine(p);
  navigator.clipboard.writeText(line).then(() => {
    toast('Copied for Clay');
  });
}

function markAllPushedToClay() {
  const clayProspects = getClayProspects();
  if (!clayProspects.length) return;
  const prospects = loadProspects();
  const clayIds = new Set(clayProspects.map(p => p.id));
  let count = 0;
  prospects.forEach(p => {
    if (clayIds.has(p.id)) {
      p.pushedToClay = true;
      count++;
    }
  });
  saveProspects(prospects);
  refreshClayPanel();
  updateClayCount();
  toast('Marked ' + count + ' as pushed');
}

