/* ══════════════════════════════════════════════════════════════
   CSV IMPORT
   ══════════════════════════════════════════════════════════════ */
let csvParsedRows = [];
let csvDupeMap = {};

function openCsvImport() {
  document.getElementById('csvModalOverlay').classList.add('active');
  document.getElementById('csvUploadArea').style.display = '';
  document.getElementById('csvPreviewArea').style.display = 'none';
  document.getElementById('csvFileInput').value = '';
  csvParsedRows = [];
  csvDupeMap = {};
}

function closeCsvModal() {
  document.getElementById('csvModalOverlay').classList.remove('active');
}
function closeCsvModalOverlay(e) { if (e.target === e.currentTarget) closeCsvModal(); }

function parseCSV(text) {
  const lines = text.split(/\r?\n/);
  if (lines.length < 2) return [];
  const headers = parseCSVLine(lines[0]).map(h => h.trim().toLowerCase());
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    if (!lines[i].trim()) continue;
    const vals = parseCSVLine(lines[i]);
    const obj = {};
    headers.forEach((h, idx) => { obj[h] = (vals[idx] || '').trim(); });
    rows.push(obj);
  }
  return rows;
}

function parseCSVLine(line) {
  const result = [];
  let current = '';
  let inQuotes = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (inQuotes) {
      if (ch === '"') {
        if (i + 1 < line.length && line[i + 1] === '"') {
          current += '"';
          i++;
        } else {
          inQuotes = false;
        }
      } else {
        current += ch;
      }
    } else {
      if (ch === '"') {
        inQuotes = true;
      } else if (ch === ',') {
        result.push(current);
        current = '';
      } else {
        current += ch;
      }
    }
  }
  result.push(current);
  return result;
}

function getCSVField(row, ...keys) {
  for (const k of keys) {
    if (row[k] !== undefined && row[k] !== '') return row[k];
  }
  return '';
}

function extractDomain(url) {
  try {
    return new URL(url.startsWith('http') ? url : 'https://' + url).hostname.replace(/^www\./, '').toLowerCase();
  } catch { return url.toLowerCase(); }
}

function handleCsvFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    try {
      const rows = parseCSV(ev.target.result);
      if (!rows.length) { toast('CSV is empty or invalid'); return; }
      processCsvRows(rows);
    } catch (err) {
      toast('CSV parse error: ' + err.message);
    }
  };
  reader.readAsText(file);
}

function processCsvRows(rows) {
  const existing = loadAgencies();
  csvParsedRows = [];
  csvDupeMap = {};

  // Build lookup sets
  const domainSet = new Set();
  const phoneSet = new Set();
  const nameSet = new Set();
  existing.forEach(a => {
    if (a.website) domainSet.add(extractDomain(a.website));
    if (a.phones) a.phones.forEach(ph => { if (ph.number) phoneSet.add(ph.number.replace(/\D/g, '')); });
    if (a.name) nameSet.add(a.name.toLowerCase());
  });

  rows.forEach((row, idx) => {
    const name = getCSVField(row, 'company name', 'company', 'name');
    const website = getCSVField(row, 'website', 'url', 'site');
    const phone = normalizePhone(getCSVField(row, 'phone', 'phone number', 'telephone'));
    const email = getCSVField(row, 'email', 'e-mail');
    const linkedin = getCSVField(row, 'linkedin', 'linkedin url', 'linkedin company');
    const category = getCSVField(row, 'category', 'type', 'industry');
    const city = getCSVField(row, 'city');
    const state = getCSVField(row, 'state');
    const notes = getCSVField(row, 'notes', 'note', 'description');
    const source = getCSVField(row, 'source', 'source url');

    let isDupe = false;
    let dupeReason = '';
    if (website && domainSet.has(extractDomain(website))) {
      isDupe = true; dupeReason = 'website domain';
    }
    if (!isDupe && phone) {
      const digits = phone.replace(/\D/g, '');
      if (digits && phoneSet.has(digits)) { isDupe = true; dupeReason = 'phone'; }
    }
    if (!isDupe && name && nameSet.has(name.toLowerCase())) {
      isDupe = true; dupeReason = 'name';
    }

    csvParsedRows.push({
      name, website, phone, email, linkedin, category, city, state, notes, source,
      isDupe, dupeReason, skip: isDupe
    });
  });

  renderCsvPreview();
}

function renderCsvPreview() {
  const dupeCount = csvParsedRows.filter(r => r.isDupe).length;
  const newCount = csvParsedRows.length - dupeCount;
  document.getElementById('csvSummaryText').textContent = `${csvParsedRows.length} rows found. ${newCount} new, ${dupeCount} possible duplicates.`;
  document.getElementById('csvUploadArea').style.display = 'none';
  document.getElementById('csvPreviewArea').style.display = '';

  let html = '<table><thead><tr><th>Status</th><th>Company</th><th>Phone</th><th>City</th><th>Category</th><th>Action</th></tr></thead><tbody>';
  csvParsedRows.forEach((r, idx) => {
    const rowClass = r.isDupe ? ' class="dupe"' : '';
    const label = r.isDupe ? `<span class="csv-dupe-label">Dupe (${esc(r.dupeReason)})</span>` : '<span class="csv-new-label">New</span>';
    const action = r.isDupe ? `<button class="btn btn-sm" onclick="toggleCsvSkip(${idx})">${r.skip ? 'Include' : 'Skip'}</button>` : '';
    html += `<tr${rowClass}><td>${label}</td><td>${esc(r.name)}</td><td>${esc(r.phone)}</td><td>${esc(r.city)}</td><td>${esc(r.category)}</td><td>${action}</td></tr>`;
  });
  html += '</tbody></table>';
  document.getElementById('csvPreviewTable').innerHTML = html;
}

function toggleCsvSkip(idx) {
  csvParsedRows[idx].skip = !csvParsedRows[idx].skip;
  renderCsvPreview();
}

function confirmCsvImport() {
  const agencies = loadAgencies();
  let imported = 0;
  let skipped = 0;

  csvParsedRows.forEach(r => {
    if (r.skip) { skipped++; return; }
    const newAgency = {
      id: genAgencyId(agencies),
      name: r.name,
      website: r.website,
      phones: r.phone ? [{ number: r.phone, type: 'Main' }] : [],
      email: r.email,
      contactPageUrl: '',
      linkedinCompany: r.linkedin,
      address: '',
      city: r.city,
      state: r.state ? r.state.toUpperCase() : '',
      category: r.category,
      services: '',
      industries: '',
      companySize: '',
      founderName: '',
      founderLinkedin: '',
      notes: r.notes,
      sourceUrl: r.source,
      lastEnrichedAt: '',
      dataConfidence: 'B',
      status: 'new',
      outreachPriority: 'Medium',
      phoneStatus: r.phone ? 'Found' : 'Not Found',
      callOutcome: '',
      lastContactedAt: '',
      nextFollowUpAt: '',
      partnerModelInterest: '',
      owner: '',
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    };
    agencies.push(newAgency);
    imported++;
  });

  saveAgencies(agencies);
  closeCsvModal();
  renderAgencyBoard();
  toast(`Imported ${imported} / Skipped ${skipped} duplicates`);
}

