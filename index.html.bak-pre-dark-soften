// Feedback textarea rendered as a separate row beneath the footer
// so it doesn't squeeze the action pills.
function renderFeedbackRow(p) {
  if (p.rating !== 'up' && p.rating !== 'down') return '';
  const placeholder = p.rating === 'down' ? 'why? helps tomorrow\'s prospecting' : 'what stood out?';
  return `<div class="glass-feedback-row">
    <textarea class="rating-feedback" placeholder="${placeholder}"
      onclick="event.stopPropagation()"
      onblur="saveFeedback('${p.id}',this)"
      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();this.blur();}"
    >${esc(p.feedback || '')}</textarea>
  </div>`;
}

function renderGraveyardRow(id) {
  return `<div class="graveyard-row">
    <button class="graveyard-btn broken" onclick="event.stopPropagation();moveToGraveyard('${id}','link_broken')" title="Link broken">&#8856; Link broken</button>
    <button class="graveyard-btn thindata" onclick="event.stopPropagation();moveToGraveyard('${id}','not_enough_data')" title="Thin data">! Thin data</button>
    <button class="graveyard-btn bury-btn" onclick="event.stopPropagation();moveToGraveyard('${id}','manual_bury')" title="Send to graveyard">&#x26B0; Bury</button>
  </div>`;
}

function moveToGraveyard(id, reason) {
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx > -1) {
    prospects[idx].status = 'graveyard';
    prospects[idx].graveyard_reason = reason;
    prospects[idx].ratedAt = new Date().toISOString();
    saveProspects(prospects);
    renderBoard();
    const labels = { link_broken: 'link broken', not_enough_data: 'not enough data', manual_bury: 'buried' };
    toast('Moved to Graveyard (' + (labels[reason] || reason) + ')');
  }
}

/* ──────────────────────────────────────────────────────────────
   REPORT BROKEN LINK  (James approved option b, 2026-05-19)

   PERSISTENCE MODEL — static site, no backend:
   This is a static Vercel deploy serving a read-only prospects.json
   (a cron owns writes to that file in the repo; the page must NOT and
   CANNOT POST to it). So localStorage is the SOURCE OF TRUTH at runtime:
     1. reportBroken() sets p.{platform}_status = 'broken' in the
        localStorage prospect array (loadProspects/saveProspects) AND in
        the in-memory render, so the card greys that icon immediately and
        the change survives reloads.
     2. To sync the flag back to the repo / sellers' reports, the user
        clicks the existing toolbar "Export JSON" button — exportData()
        now downloads the full, edited array AS prospects.json, which can
        be dropped straight into the repo (or fed to the cron) to make the
        broken flag durable beyond this browser.
   No invented API. Matches the current static-site architecture exactly.
   ────────────────────────────────────────────────────────────── */
function toggleReportBroken(id) {
  const panel = document.getElementById('rbp-' + id);
  if (!panel) return;
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}

function reportBroken(id, platform) {
  if (!['linkedin', 'instagram', 'youtube'].includes(platform)) return;
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx === -1) return;
  const field = platform + '_status';
  // Toggle: re-clicking a flagged platform clears it back to 'missing'
  // (don't fabricate 'valid' — we can't reverify here).
  prospects[idx][field] = prospects[idx][field] === 'broken' ? 'missing' : 'broken';
  prospects[idx].updatedAt = new Date().toISOString();
  saveProspects(prospects);
  renderBoard();
  toast(prospects[idx][field] === 'broken'
    ? `${platform} flagged broken — Export JSON to sync`
    : `${platform} flag cleared`);
}

function markAddedToCRM(id) {
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx > -1) {
    prospects[idx].status = 'added_to_crm';
    saveProspects(prospects);
    renderBoard();
    toast('Moved to Added to CRM');
  }
}

function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
function formatDate(d) { return new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }

/* ── Drag & Drop (Clients) ── */
let draggedId = null;

function handleDragStart(e, id) {
  draggedId = id;
  e.target.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
}
function handleDragEnd(e) {
  e.target.classList.remove('dragging');
  document.querySelectorAll('.column-body').forEach(c => c.classList.remove('drag-over'));
}
function handleDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; }
function handleDragEnter(e) {
  e.preventDefault();
  const col = e.target.closest('.column-body');
  if (col) col.classList.add('drag-over');
}
function handleDragLeave(e) {
  const col = e.target.closest('.column-body');
  if (col && !col.contains(e.relatedTarget)) col.classList.remove('drag-over');
}
function handleDrop(e) {
  e.preventDefault();
  const col = e.target.closest('.column-body');
  if (!col || !draggedId) return;
  col.classList.remove('drag-over');
  const newStatus = col.dataset.status;

  // Route to correct handler based on current view
  if (currentView === 'agency') {
    handleAgencyDrop(draggedId, newStatus);
  } else {
    const prospects = loadProspects();
    const idx = prospects.findIndex(p => p.id === draggedId);
    if (idx > -1 && prospects[idx].status !== newStatus) {
      prospects[idx].status = newStatus;
      saveProspects(prospects);
      renderBoard();
      toast(`Moved to ${COLUMNS.find(c => c.id === newStatus).label}`);
    }
  }
  draggedId = null;
}

