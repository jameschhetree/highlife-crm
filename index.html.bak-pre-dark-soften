/* ── Rating / Feedback ── */
function renderRatingRow(p) {
  const upClass = p.rating === 'up' ? ' up-active' : '';
  const downClass = p.rating === 'down' ? ' down-active' : '';
  const showFeedback = p.rating === 'down' || p.rating === 'up';
  const placeholder = p.rating === 'down' ? 'why? helps tomorrow\'s prospecting' : 'what stood out?';
  return `<div class="rating-row">
    <button class="rating-btn${upClass}" onclick="event.stopPropagation();setRating('${p.id}','up')" title="Good prospect">&#128077;</button>
    <button class="rating-btn${downClass}" onclick="event.stopPropagation();setRating('${p.id}','down')" title="Bad prospect">&#128078;</button>
    ${showFeedback ? `<textarea class="rating-feedback" placeholder="${placeholder}"
      onclick="event.stopPropagation()"
      onblur="saveFeedback('${p.id}',this)"
      onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();this.blur();}"
    >${esc(p.feedback || '')}</textarea>` : ''}
  </div>`;
}

function setRating(id, value) {
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx === -1) return;
  const current = prospects[idx].rating;
  if (current === value) {
    prospects[idx].rating = null;
    prospects[idx].ratedAt = null;
  } else {
    prospects[idx].rating = value;
    prospects[idx].ratedAt = new Date().toISOString();
  }
  saveProspects(prospects);
  renderBoard();
  toast('Rating saved');
}

function saveFeedback(id, el) {
  const value = el.value.trim();
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx === -1) return;
  if ((prospects[idx].feedback || '') === value) return;
  prospects[idx].feedback = value;
  saveProspects(prospects);
  toast('Feedback saved');
}

/* ── Export Feedback ── */
function exportFeedback() {
  const all = loadProspects();
  const rated = all.filter(p => p.rating != null || p.graveyard_reason);
  if (!rated.length) { toast('No rated or graveyard prospects to export'); return; }
  const payload = {
    exportedAt: new Date().toISOString(),
    count: rated.length,
    prospects: rated.map(p => ({
      id: p.id,
      name: p.name,
      jobTitle: p.jobTitle || '',
      company: p.company || '',
      rating: p.rating || null,
      feedback: p.feedback || '',
      ratedAt: p.ratedAt,
      package: p.package || '',
      source: p.source || '',
      location: p.location || '',
      graveyard_reason: p.graveyard_reason || null,
      status: p.status,
    }))
  };
  const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `highlife-feedback-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
  toast('Feedback exported');
}

