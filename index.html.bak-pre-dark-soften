function closeModal() { document.getElementById('modalOverlay').classList.remove('active'); }
function closeModalOverlay(e) { if (e.target === e.currentTarget) closeModal(); }

function saveProspect(e) {
  e.preventDefault();
  const prospects = loadProspects();
  const editId = document.getElementById('editId').value;
  const data = {
    id: editId || genId(),
    name: document.getElementById('f-name').value.trim(),
    jobTitle: document.getElementById('f-title').value.trim(),
    company: document.getElementById('f-company').value.trim(),
    source: document.getElementById('f-source').value,
    email: document.getElementById('f-email').value.trim(),
    phone: document.getElementById('f-phone').value.trim(),
    linkedin: document.getElementById('f-linkedin').value.trim(),
    youtube: document.getElementById('f-youtube').value.trim(),
    instagram: document.getElementById('f-instagram').value.trim(),
    package: document.getElementById('f-package').value,
    status: document.getElementById('f-status').value,
    lastContact: document.getElementById('f-lastContact').value,
    notes: document.getElementById('f-notes').value.trim(),
    createdAt: editId ? (prospects.find(p => p.id === editId) || {}).createdAt || new Date().toISOString() : new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    rating: editId ? (prospects.find(p => p.id === editId) || {}).rating || null : null,
    feedback: editId ? (prospects.find(p => p.id === editId) || {}).feedback || '' : '',
    ratedAt: editId ? (prospects.find(p => p.id === editId) || {}).ratedAt || null : null,
    graveyard_reason: editId ? (prospects.find(p => p.id === editId) || {}).graveyard_reason || null : null,
    pushedToClay: editId ? (prospects.find(p => p.id === editId) || {}).pushedToClay || false : false,
    twitter: editId ? (prospects.find(p => p.id === editId) || {}).twitter || '' : '',
  };
  if (editId) {
    const idx = prospects.findIndex(p => p.id === editId);
    if (idx > -1) prospects[idx] = data;
  } else {
    prospects.push(data);
  }
  saveProspects(prospects);
  closeModal();
  renderBoard();
  toast(editId ? 'Prospect updated' : 'Prospect added');
}

function editProspect(id) { openModal(id); }

const SELLERS = ['Jaco', 'Liam', 'Hayden'];

function renderSellerRow(p) {
  const active = p.seller || '';
  const buttons = SELLERS.map(s => {
    const isActive = active === s;
    return `<button class="seller-btn${isActive ? ' active' : ''}" onclick="event.stopPropagation(); setSeller('${p.id}','${s}')">${isActive ? '&#10003; ' : ''}${s}</button>`;
  }).join('');
  return `<div class="seller-row">${buttons}</div>`;
}

function setSeller(id, name) {
  const prospects = loadProspects();
  const p = prospects.find(x => x.id === id);
  if (!p) return;
  // Toggle: clicking the active seller clears it
  p.seller = (p.seller === name) ? '' : name;
  saveProspects(prospects);
  renderBoard();
  toast(p.seller ? `Assigned to ${name}` : 'Seller cleared');
}

let inlineEdit = { id: null, field: null };

function renderContactLine(p, field) {
  const isEditing = inlineEdit.id === p.id && inlineEdit.field === field;
  const labels = { email: '+ Add email', phone: '+ Add phone' };
  const icons  = { email: '&#x1F4E7;', phone: '&#x260E;&#xFE0F;' };
  const types  = { email: 'email',     phone: 'tel' };
  const placeholders = { email: 'name@example.com', phone: '(555) 123-4567' };
  if (isEditing) {
    return `<input type="${types[field]}" class="contact-input"
              placeholder="${placeholders[field]}"
              value="${esc(p[field] || '')}"
              data-pid="${p.id}" data-field="${field}"
              onclick="event.stopPropagation()"
              onkeydown="handleInlineKey(event)"
              onblur="commitInlineEdit(this)">`;
  }
  if (p[field]) {
    const href = field === 'email' ? `mailto:${esc(p[field])}` : `tel:${esc(p[field])}`;
    return `<a href="${href}" class="contact-link" onclick="event.stopPropagation()">${icons[field]} ${esc(p[field])}</a>`;
  }
  return `<button class="add-contact" onclick="event.stopPropagation();startInlineAdd('${p.id}','${field}')">${labels[field]}</button>`;
}

function startInlineAdd(id, field) {
  inlineEdit = { id, field };
  renderBoard();
  setTimeout(() => {
    const input = document.querySelector(`.contact-input[data-pid="${id}"][data-field="${field}"]`);
    if (input) input.focus();
  }, 0);
}

function handleInlineKey(e) {
  if (e.key === 'Enter') { e.preventDefault(); commitInlineEdit(e.target); }
  else if (e.key === 'Escape') { e.preventDefault(); inlineEdit = { id: null, field: null }; renderBoard(); }
}

function commitInlineEdit(input) {
  const id = input.dataset.pid;
  const field = input.dataset.field;
  if (inlineEdit.id !== id || inlineEdit.field !== field) return;
  const value = input.value.trim();
  inlineEdit = { id: null, field: null };
  const prospects = loadProspects();
  const idx = prospects.findIndex(p => p.id === id);
  if (idx > -1 && (prospects[idx][field] || '') !== value) {
    prospects[idx][field] = value;
    saveProspects(prospects);
