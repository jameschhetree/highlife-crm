function genAgencyId(agencies) {
  let maxNum = 0;
  (agencies || loadAgencies()).forEach(a => {
    if (a.id && typeof a.id === 'string' && a.id.startsWith('a')) {
      const num = parseInt(a.id.slice(1), 10);
      if (!isNaN(num) && num > maxNum) maxNum = num;
    }
  });
  return 'a' + (maxNum + 1);
}

