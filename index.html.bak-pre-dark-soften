}

.prospect-card .card-head{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:10px;margin-bottom:10px;
}
.prospect-card .card-head-left{min-width:0;flex:1}
.prospect-card .card-head-right{
  display:flex;align-items:center;gap:6px;flex-shrink:0;
}
.prospect-card .card-badges{
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;
  margin-top:8px;
}

.prospect-card .name{
  font-weight:700;font-size:1.25rem;margin-bottom:4px;
  color:var(--text-heading);letter-spacing:-.02em;line-height:1.2;
  overflow:hidden;text-overflow:ellipsis;
}
.prospect-card .title-co{
  font-size:.875rem;color:var(--text-dim);line-height:1.45;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.prospect-card .title-co .at{color:var(--text-muted);margin:0 4px;font-weight:400}
.prospect-card .title-co .company{color:var(--text);font-weight:500}

.prospect-card .pkg-badge{
  display:inline-flex;align-items:center;padding:3px 9px;
  border-radius:var(--radius-pill);font-size:.7rem;font-weight:600;
  background:var(--pill-bg);color:var(--text-dim);
  letter-spacing:.01em;white-space:nowrap;line-height:1.4;
}
.prospect-card .status-pill{
  display:inline-flex;align-items:center;padding:3px 9px;
  border-radius:var(--radius-pill);font-size:.65rem;font-weight:700;
  letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;line-height:1.4;
}
.prospect-card .status-pill.s-added_to_crm{background:rgba(99,102,241,0.12);color:#4F46E5}
.prospect-card .status-pill.s-contacted  {background:rgba(20,184,166,0.14);color:#0D9488}
.prospect-card .status-pill.s-tour_booked{background:rgba(245,158,11,0.16);color:#B45309}
.prospect-card .status-pill.s-demo       {background:rgba(168,85,247,0.14);color:#7C3AED}
.prospect-card .status-pill.s-client     {background:rgba(34,197,94,0.16);color:#15803D}
.prospect-card .status-pill.s-lost       {background:rgba(239,68,68,0.10);color:#B91C1C}
body[data-theme="dark"] .prospect-card .status-pill.s-added_to_crm{background:rgba(129,140,248,0.18);color:#A5B4FC}
body[data-theme="dark"] .prospect-card .status-pill.s-contacted  {background:rgba(45,212,191,0.18);color:#5EEAD4}
body[data-theme="dark"] .prospect-card .status-pill.s-tour_booked{background:rgba(251,191,36,0.18);color:#FCD34D}
body[data-theme="dark"] .prospect-card .status-pill.s-demo       {background:rgba(192,132,252,0.20);color:#D8B4FE}
body[data-theme="dark"] .prospect-card .status-pill.s-client     {background:rgba(74,222,128,0.20);color:#86EFAC}
body[data-theme="dark"] .prospect-card .status-pill.s-lost       {background:rgba(248,113,113,0.18);color:#FCA5A5}

/* Social icons row */
.prospect-card .social-icons{
  display:flex;align-items:center;gap:6px;margin:10px 0 12px;
}
.prospect-card .social-icon{
  width:26px;height:26px;border-radius:7px;
  display:inline-flex;align-items:center;justify-content:center;
  color:#fff;text-decoration:none;flex-shrink:0;
  transition:transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease), opacity var(--duration) var(--ease);
  box-shadow:0 1px 2px rgba(0,0,0,0.08);
}
.prospect-card .social-icon svg{width:14px;height:14px;display:block}
.prospect-card .social-icon:hover{transform:translateY(-1px);box-shadow:0 3px 8px rgba(0,0,0,0.16)}
.prospect-card .social-icon--linkedin{background:#0A66C2}
.prospect-card .social-icon--instagram{
  background:radial-gradient(circle at 30% 110%, #FFDC80 0%, #FCAF45 12%, #F77737 25%, #F56040 41%, #FD1D1D 55%, #E1306C 70%, #C13584 80%, #833AB4 95%);
}
.prospect-card .social-icon--youtube{background:#FF0000}
.prospect-card .social-icon--missing{
  background:var(--pill-bg);color:var(--text-muted);
  opacity:.4;cursor:default;pointer-events:none;box-shadow:none;
}
.prospect-card .social-icon--missing svg{color:var(--text-muted)}
body[data-theme="dark"] .prospect-card .social-icon--missing{background:rgba(255,255,255,0.04)}

.prospect-card .last-contact{
  font-size:.75rem;color:var(--text-muted);margin-top:10px;
  letter-spacing:.01em;
}
.prospect-card .last-contact .lc-label{color:var(--text-muted);opacity:.7;margin-right:4px}

/* Legacy meta (still used for graveyard reason badge) */
.prospect-card .meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.prospect-card .meta-tag{
  font-size:.7rem;padding:3px 10px;border-radius:var(--radius-pill);
  background:var(--pill-bg);color:var(--text-muted);font-weight:600;letter-spacing:.04em;
  transition:all var(--duration) var(--ease);
}
.prospect-card .meta-missing{
  background:transparent;color:var(--text-muted);
  border:1px dashed var(--border-dashed);
}

.crm-btn{
  width:100%;margin-top:10px;padding:10px 0;
  font-size:.8rem;font-weight:600;letter-spacing:.02em;
  color:var(--text-dim);background:var(--btn-bg);
  border:1px solid var(--btn-border);border-radius:var(--radius-sm);
  box-shadow:var(--shadow-sm);
  cursor:pointer;transition:all var(--duration) var(--ease);
  text-transform:uppercase;
}
.crm-btn:hover{background:var(--primary-bg);border-color:var(--primary-bg);color:var(--primary-text);transform:translateY(-1px)}
.crm-btn-secondary{
  width:100%;margin-top:10px;padding:8px 0;
  font-size:.75rem;font-weight:600;letter-spacing:.02em;
  color:var(--text-dim);background:transparent;
  border:1px dashed var(--btn-border);border-radius:var(--radius-sm);
  cursor:pointer;transition:all var(--duration) var(--ease);
  text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:5px;
}
.crm-btn-secondary:hover{border-color:var(--border-active);color:var(--text-heading);background:var(--btn-bg);transform:translateY(-1px)}

/* ── Rating Row ───────────────────────────────────────────── */
.rating-row{display:flex;align-items:center;gap:6px;margin-top:12px;margin-bottom:0}
.rating-btn{
  width:42px;height:42px;border-radius:var(--radius-sm);
  background:var(--btn-bg);border:1px solid var(--border);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:1rem;transition:all var(--duration) var(--ease);flex-shrink:0;
  filter:grayscale(1) brightness(.7);
  box-shadow:var(--shadow-sm);
}
.rating-btn:hover{border-color:var(--border-active);filter:grayscale(0);transform:translateY(-1px)}
.rating-btn.up-active{border-color:var(--border-active);filter:grayscale(0);background:var(--pill-bg)}
.rating-btn.down-active{border-color:var(--border-active);filter:grayscale(0);background:var(--pill-bg)}
.rating-feedback{
  flex:1;min-width:0;
  font-size:.8125rem;color:var(--text);
  background:var(--input-bg);border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:8px 12px;resize:none;outline:none;
  overflow:hidden;height:32px;line-height:1.4;
  transition:all var(--duration) var(--ease);
  box-shadow:var(--shadow-sm);
}
.rating-feedback:focus{border-color:var(--border-active);height:56px;background:var(--input-bg);box-shadow:var(--shadow-focus)}
.rating-feedback::placeholder{color:var(--text-muted);font-size:.8rem}

/* ── Graveyard Column — visually receded ─────────────────── */
.column.graveyard-col{
  opacity:0.55;
  transition:all var(--duration) var(--ease);
}
.column.graveyard-col:hover{
  opacity:0.75;
}
.column.graveyard-col .column-header{background:transparent}
.column.graveyard-col .column-title{color:var(--graveyard-text)}
.column.graveyard-col .column-count{background:var(--graveyard-pill-bg);color:var(--graveyard-text)}
.column.graveyard-col .prospect-card{
  background:var(--graveyard-card-bg);border-color:var(--graveyard-card-border);
  box-shadow:var(--graveyard-card-shadow);
}
.column.graveyard-col .prospect-card:hover{border-color:var(--graveyard-card-hover-border);box-shadow:var(--shadow-card);transform:none}
.column.graveyard-col .prospect-card .name{color:var(--graveyard-text)}
.column.graveyard-col .prospect-card .title-co{color:var(--graveyard-text-sub)}

/* ── Graveyard Action Buttons ─────────────────────────────── */
.graveyard-row{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}
.graveyard-btn{
  flex:1 1 auto;min-width:0;padding:8px 12px;border-radius:var(--radius-sm);
  font-size:.75rem;font-weight:600;letter-spacing:.01em;
  color:var(--text-muted);background:var(--btn-bg);
  border:1px solid var(--border);cursor:pointer;
  box-shadow:var(--shadow-sm);
  transition:all var(--duration) var(--ease);display:flex;align-items:center;
  justify-content:center;gap:4px;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;
}
.graveyard-btn:hover{background:var(--primary-bg);border-color:var(--primary-bg);color:var(--primary-text);transform:translateY(-1px)}
.graveyard-btn.bury-btn{color:var(--graveyard-text)}
.graveyard-btn.bury-btn:hover{color:var(--primary-text);background:var(--primary-bg);border-color:var(--primary-bg)}

/* ── Contact Block ────────────────────────────────────────── */
.prospect-card .contact-block{display:flex;flex-direction:column;gap:5px;margin-bottom:8px}
.prospect-card .contact-link{
  font-size:.8125rem;color:var(--text-muted);text-decoration:none;
  transition:color var(--duration) var(--ease);display:inline-flex;align-items:center;gap:6px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;
  font-family:var(--font-mono);font-size:.8rem;
}
.prospect-card .contact-link:hover{color:var(--text-heading)}
.prospect-card .add-contact{
  font-size:.8rem;color:var(--text-muted);
  background:none;border:1px dashed var(--border-dashed);border-radius:var(--radius-sm);
  padding:5px 10px;cursor:pointer;transition:all var(--duration) var(--ease);
  display:inline-flex;align-items:center;gap:4px;width:fit-content;
}
.prospect-card .add-contact:hover{border-color:var(--border-active);color:var(--text-heading)}
.prospect-card .contact-input{
  font-size:.8125rem;color:var(--text);
  background:var(--input-bg);border:1px solid var(--border-active);border-radius:var(--radius-sm);
  padding:8px 12px;width:100%;box-sizing:border-box;outline:none;
  font-family:var(--font-mono);
  transition:all var(--duration) var(--ease);
}
.prospect-card .contact-input:focus{border-color:var(--text-heading);box-shadow:var(--shadow-focus)}
.prospect-card .card-actions{
  display:inline-flex;align-items:center;padding:2px;gap:2px;
  background:var(--surface);border:1px solid var(--border);border-radius:10px;
  opacity:0;transition:opacity var(--duration) var(--ease);
  backdrop-filter:saturate(140%);
}
.prospect-card:hover .card-actions, .prospect-card:focus-within .card-actions{opacity:1}
.card-action-btn{
  width:26px;height:26px;border-radius:7px;
  background:transparent;border:none;
  color:var(--text-muted);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:.72rem;transition:background var(--duration) var(--ease), color var(--duration) var(--ease);
}
.card-action-btn:hover{background:var(--pill-bg-hover);color:var(--text-heading)}
.card-action-btn.delete:hover{background:rgba(239,68,68,0.10);color:#B91C1C}
body[data-theme="dark"] .card-action-btn.delete:hover{background:rgba(248,113,113,0.18);color:#FCA5A5}

/* ── Modal ─────────────────────────────────────────────────── */
.modal-overlay{
  position:fixed;inset:0;background:var(--overlay);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  display:none;align-items:center;justify-content:center;
  z-index:100;padding:32px;
}
.modal-overlay.active{display:flex}
.modal{
  background:var(--bg);
  border:1px solid var(--border);
  box-shadow:var(--shadow-modal);
  border-radius:24px;padding:32px;
  width:100%;max-width:540px;max-height:90vh;overflow-y:auto;
  animation:modalIn 340ms var(--ease);
}
.modal.modal-wide{max-width:680px}
@keyframes modalIn{
  from{opacity:0;transform:scale(0.97) translateY(8px)}
  to{opacity:1;transform:scale(1) translateY(0)}
}
.modal h2{font-size:1.25rem;font-weight:700;margin-bottom:24px;color:var(--text-heading);letter-spacing:-.02em}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group.full{grid-column:1/-1}
.form-group label{font-size:.75rem;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);font-weight:500}
.form-group input,.form-group select,.form-group textarea{
  padding:12px 14px;
  background:var(--input-bg);border:1px solid var(--btn-border);
  border-radius:var(--radius-btn);color:var(--text);
  outline:none;transition:all var(--duration) var(--ease);
  font-size:.9375rem;
}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--border-active);box-shadow:var(--shadow-focus)}
.form-group textarea{resize:vertical;min-height:72px}
.form-group select option{background:var(--bg);color:var(--text)}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px}

/* ── Toast ─────────────────────────────────────────────────── */
.toast{
  position:fixed;bottom:28px;right:28px;
  padding:12px 24px;border-radius:var(--radius-btn);
  background:var(--toast-bg);border:none;
  color:var(--toast-text);font-weight:600;font-size:.875rem;
  box-shadow:var(--shadow-toast);
  transform:translateY(80px);opacity:0;
  transition:all 340ms var(--ease);
  z-index:200;
}
.toast.show{transform:translateY(0);opacity:1}

/* ── Empty State ───────────────────────────────────────────── */
.empty-col{
  text-align:center;padding:24px 14px;
  color:var(--text-muted);font-size:.8125rem;
  border:1px dashed var(--border-dashed);border-radius:var(--radius);
  margin:4px 0;
}

/* ── Auth User Badge ────────────────────────────────────────── */
.auth-user{
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 18px;border-radius:var(--radius-btn);
  background:var(--btn-bg);border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  font-size:.875rem;font-weight:500;color:var(--text-muted);
}
.auth-user span{color:var(--text-heading);font-weight:600}

/* ── Product Portfolio ──────────────────────────────────────── */
.portfolio{margin-top:48px}
.portfolio-heading{display:flex;align-items:baseline;gap:14px;margin-bottom:24px}
.portfolio-heading h2{font-size:1.25rem;font-weight:700;letter-spacing:-.02em;color:var(--text-heading)}
.portfolio-heading p{font-size:.75rem;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-muted)}
.portfolio-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:16px;
}
.product-card{
  background:var(--bg-card);
  border:1px solid var(--border);
  box-shadow:var(--shadow-card);
  border-radius:var(--radius);
  padding:24px 22px;
  transition:all var(--duration) var(--ease);
}
.product-card:hover{box-shadow:var(--shadow-card-hover);transform:translateY(-1px)}
.product-icon{
  width:40px;height:40px;border-radius:12px;
  background:var(--product-icon-bg);border:1px solid var(--product-icon-border);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:14px;
}
.product-icon svg{width:18px;height:18px;fill:none;stroke:var(--product-icon-stroke);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.product-name{font-size:1rem;font-weight:600;color:var(--text-heading);margin-bottom:5px;letter-spacing:-.01em}
.product-desc{font-size:.8125rem;color:var(--text-muted);line-height:1.5;margin-bottom:14px}
.product-status{
  display:inline-flex;align-items:center;gap:5px;
  font-size:.7rem;font-weight:600;letter-spacing:.5px;text-transform:uppercase;
  padding:4px 12px;border-radius:var(--radius-pill);
}
.product-status.active{background:var(--product-active-bg);color:var(--text-dim)}
.product-status.active::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--product-active-dot);display:inline-block}
.product-status.coming-soon{background:var(--product-soon-bg);color:var(--text-muted)}
.product-status.coming-soon::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--product-coming-dot);display:inline-block}
.product-status.inactive{background:var(--product-inactive-bg);color:var(--text-muted)}
.product-status.inactive::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--product-inactive-dot);display:inline-block}

/* ── Quick Add Section ─────────────────────────────────────── */
.quick-add-section{margin-bottom:24px}

.quick-add-trigger{
  display:flex;align-items:center;gap:8px;
  padding:12px 20px;border-radius:var(--radius-btn);
  background:var(--bg-card);border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  cursor:pointer;transition:all var(--duration) var(--ease);
  color:var(--text-muted);font-size:.875rem;font-weight:600;
  letter-spacing:.01em;width:fit-content;
  user-select:none;
}
.quick-add-trigger:hover{
  border-color:var(--border-active);color:var(--text);
  background:var(--btn-bg-hover);transform:translateY(-1px);
  box-shadow:var(--shadow-btn-hover);
}
.quick-add-trigger svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0;transition:transform 200ms var(--ease)}
.quick-add-trigger.open svg{transform:rotate(45deg)}

.quick-add-form{
  display:none;
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow-card);
  padding:24px;margin-top:12px;
  animation:qaSlideIn 280ms var(--ease);
}
.quick-add-form.visible{display:block}
@keyframes qaSlideIn{
  from{opacity:0;transform:translateY(-6px)}
  to{opacity:1;transform:translateY(0)}
}

.qa-row{
  display:grid;
  grid-template-columns:1fr 1fr 1fr 1fr;
  gap:14px;
  margin-bottom:14px;
}
.qa-row:last-of-type{margin-bottom:0}
.qa-field{display:flex;flex-direction:column;gap:5px}
.qa-field.span-2{grid-column:span 2}
.qa-field label{
  font-size:.7rem;text-transform:uppercase;letter-spacing:1px;
  color:var(--text-muted);font-weight:500;
}
.qa-field input,.qa-field select{
  padding:10px 12px;
  background:var(--input-bg);border:1px solid var(--btn-border);
  border-radius:var(--radius-btn);color:var(--text);
  outline:none;transition:all var(--duration) var(--ease);
  font-size:.875rem;
}
.qa-field input:focus,.qa-field select:focus{border-color:var(--border-active);box-shadow:var(--shadow-focus)}
.qa-field input::placeholder{color:var(--text-muted);font-size:.8125rem}
.qa-field select option{background:var(--bg);color:var(--text)}
.qa-field .qa-error{
  font-size:.7rem;color:#e53935;font-weight:500;
  margin-top:2px;min-height:0;display:none;
}
.qa-field .qa-error.show{display:block}
.qa-field .qa-warn{
  font-size:.7rem;color:#f9a825;font-weight:500;
  margin-top:2px;min-height:0;display:none;
}
.qa-field .qa-warn.show{display:block}
.qa-field input.field-error{border-color:#e53935}
.qa-field input.field-warn{border-color:#f9a825}

.qa-actions{
  display:flex;gap:10px;justify-content:flex-start;margin-top:18px;
}

/* ── Agency Card Specifics ────────────────────────────────── */
.agency-card{
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow-card);
  padding:22px;cursor:grab;
  transition:all var(--duration) var(--ease);
  position:relative;
}
.agency-card:hover{box-shadow:var(--shadow-card-hover);transform:translateY(-1px)}
.agency-card.dragging{opacity:.4}
.agency-card .agency-name{font-weight:600;font-size:1.1rem;margin-bottom:3px;color:var(--text-heading);letter-spacing:-.01em;line-height:1.3}
.agency-card .agency-sub{font-size:.8125rem;color:var(--text-muted);margin-bottom:10px;line-height:1.4}
.agency-card .agency-phone{
  display:inline-flex;align-items:center;gap:6px;
  font-family:var(--font-mono);font-size:.875rem;font-weight:600;
  color:var(--text-heading);text-decoration:none;
  margin-bottom:10px;transition:color var(--duration) var(--ease);
}
.agency-card .agency-phone:hover{color:var(--text-dim)}
.agency-card .agency-phone svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}
.agency-card .agency-badges{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.agency-card .fit-badge{
  display:inline-flex;align-items:center;
  padding:3px 10px;border-radius:var(--radius-pill);
  font-size:.7rem;font-weight:600;letter-spacing:.02em;
  border:1px solid var(--border);color:var(--text-dim);
  background:transparent;
}
.agency-card .fit-badge.fit-a{border-color:rgba(52,199,89,.4);color:rgba(52,199,89,1)}
.agency-card .fit-badge.fit-b{border-color:rgba(255,159,10,.4);color:rgba(255,159,10,1)}
.agency-card .fit-badge.fit-c{border-color:var(--border);color:var(--text-muted)}
.agency-card .priority-dot{
  width:8px;height:8px;border-radius:50%;display:inline-block;flex-shrink:0;
}
.agency-card .priority-dot.high{background:#ff3b30}
.agency-card .priority-dot.medium{background:#ff9500}
.agency-card .priority-dot.low{background:var(--text-muted)}
.agency-card .agency-meta-row{
  display:flex;align-items:center;gap:8px;margin-bottom:6px;
}
.agency-card .card-actions{
  position:absolute;top:12px;right:12px;
  display:flex;gap:4px;opacity:0;transition:opacity var(--duration) var(--ease);
}
.agency-card:hover .card-actions{opacity:1}
.agency-card .hover-actions{
  display:flex;gap:5px;margin-top:10px;opacity:0;
  transition:opacity var(--duration) var(--ease);
}
.agency-card:hover .hover-actions{opacity:1}
.hover-action-btn{
  padding:6px 10px;border-radius:var(--radius-sm);
  font-size:.7rem;font-weight:600;
  color:var(--text-muted);background:var(--btn-bg);
  border:1px solid var(--border);cursor:pointer;
  transition:all var(--duration) var(--ease);
  display:inline-flex;align-items:center;gap:4px;
  text-decoration:none;
}
.hover-action-btn:hover{border-color:var(--border-active);color:var(--text-heading);transform:translateY(-1px)}

/* ── Agency Not Fit Column ─────────────────────────────────── */
.column.notfit-col{opacity:0.55;transition:all var(--duration) var(--ease)}
.column.notfit-col:hover{opacity:0.75}

/* ── Outreach Templates Panel ─────────────────────────────── */
.templates-panel{
  display:none;
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow-card);
  padding:24px;margin-bottom:24px;
  animation:qaSlideIn 280ms var(--ease);
}
.templates-panel.visible{display:block}
.template-block{
  background:var(--surface);
  border:1px solid var(--border-light);
  border-radius:var(--radius-sm);
  padding:18px;margin-bottom:16px;
}
.template-block:last-child{margin-bottom:0}
.template-block h3{
  font-size:.875rem;font-weight:600;color:var(--text-heading);
  margin-bottom:10px;letter-spacing:-.01em;
}
.template-block pre{
  font-family:var(--font-display);font-size:.8125rem;
  color:var(--text-dim);line-height:1.6;
  white-space:pre-wrap;word-wrap:break-word;
  margin-bottom:12px;
}
.template-block .template-actions{display:flex;gap:8px}

/* ── CSV Import Modal ─────────────────────────────────────── */
.csv-preview{
  max-height:300px;overflow-y:auto;
  margin:16px 0;
}
.csv-preview table{
  width:100%;border-collapse:collapse;font-size:.8rem;
}
.csv-preview th{
  text-align:left;padding:8px 10px;
  background:var(--surface);color:var(--text-dim);
  font-weight:600;font-size:.7rem;text-transform:uppercase;
  letter-spacing:.5px;border-bottom:1px solid var(--border);
  position:sticky;top:0;
}
.csv-preview td{
  padding:8px 10px;border-bottom:1px solid var(--border-light);
  color:var(--text);
}
.csv-preview tr.dupe{background:rgba(255,159,10,.08)}
.csv-dupe-label{
  font-size:.7rem;font-weight:600;color:#ff9500;
  padding:2px 8px;border-radius:var(--radius-pill);
  background:rgba(255,159,10,.1);
}
.csv-new-label{
  font-size:.7rem;font-weight:600;color:rgba(52,199,89,1);
  padding:2px 8px;border-radius:var(--radius-pill);
  background:rgba(52,199,89,.1);
}

/* ── Phone Rows in Agency Modal ───────────────────────────── */
.phone-rows{display:flex;flex-direction:column;gap:8px}
.phone-row{display:flex;gap:8px;align-items:center}
.phone-row input{flex:1}
.phone-row select{width:120px}
.phone-row .remove-phone-btn{
  width:28px;height:28px;border-radius:var(--radius-sm);
  background:var(--surface);border:1px solid var(--border);
  color:var(--text-muted);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:.8rem;transition:all var(--duration) var(--ease);
  flex-shrink:0;
}
.phone-row .remove-phone-btn:hover{border-color:var(--border-active);color:var(--text-heading)}
.add-phone-row-btn{
  font-size:.75rem;color:var(--text-muted);background:none;
  border:1px dashed var(--border-dashed);border-radius:var(--radius-sm);
  padding:6px 12px;cursor:pointer;transition:all var(--duration) var(--ease);
  display:inline-flex;align-items:center;gap:4px;width:fit-content;margin-top:4px;
}
.add-phone-row-btn:hover{border-color:var(--border-active);color:var(--text-heading)}

/* ── Seller assignment row (prospect cards) ─────────────── */
.seller-row{
  display:flex;gap:6px;margin:0 0 0;
}
.seller-btn{
  flex:1;font-size:.7rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  padding:6px 8px;border-radius:var(--radius-sm);cursor:pointer;
  background:transparent;border:1px solid var(--border-dashed);color:var(--text-muted);
  transition:all var(--duration) var(--ease);
}
.seller-btn:hover{border-color:var(--border-active);color:var(--text-heading)}
.seller-btn.active{
  background:#C9A04A;border-color:#C9A04A;color:#0a0a0a;
  box-shadow:0 0 0 1px rgba(201,160,74,0.25);
}

/* ── Paste to Clay Panel ──────────────────────────────────── */
.clay-panel-section{margin-bottom:24px}

.clay-panel-trigger{
  display:inline-flex;align-items:center;gap:8px;
  padding:12px 20px;border-radius:var(--radius-btn);
  background:var(--bg-card);border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  cursor:pointer;transition:all var(--duration) var(--ease);
  color:var(--text-muted);font-size:.875rem;font-weight:600;
  letter-spacing:.01em;width:fit-content;
  user-select:none;
}
.clay-panel-trigger:hover{
  border-color:var(--border-active);color:var(--text);
  background:var(--btn-bg-hover);transform:translateY(-1px);
  box-shadow:var(--shadow-btn-hover);
}
.clay-panel-trigger svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0;transition:transform 200ms var(--ease)}
.clay-panel-trigger.open svg{transform:rotate(180deg)}
.clay-panel-trigger .clay-count{
  background:var(--primary-bg);color:var(--primary-text);
  font-size:.7rem;font-weight:700;padding:2px 8px;
  border-radius:var(--radius-pill);font-variant-numeric:tabular-nums;
  margin-left:2px;
}

.clay-panel{
  display:none;
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow-card);
  padding:24px;margin-top:12px;
  animation:qaSlideIn 280ms var(--ease);
}
.clay-panel.visible{display:block}

.clay-panel-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;
}
.clay-panel-header h3{
  font-size:.875rem;font-weight:600;color:var(--text-heading);
  letter-spacing:-.01em;
}
.clay-panel-refresh{
  width:32px;height:32px;border-radius:var(--radius-sm);
  background:var(--btn-bg);border:1px solid var(--border);
  color:var(--text-muted);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all var(--duration) var(--ease);
  box-shadow:var(--shadow-sm);
}
.clay-panel-refresh:hover{border-color:var(--border-active);color:var(--text-heading);transform:rotate(90deg)}
.clay-panel-refresh svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}

.clay-textarea{
  width:100%;min-height:200px;max-height:400px;
  padding:16px;
  background:var(--surface);border:1px solid var(--border-light);
  border-radius:var(--radius-sm);
  color:var(--text);font-family:var(--font-mono);font-size:.8125rem;
  line-height:1.7;resize:vertical;outline:none;
  transition:border-color var(--duration) var(--ease);
  cursor:text;
}
.clay-textarea:focus{border-color:var(--border-active)}
.clay-textarea::selection{background:rgba(0,0,0,0.12)}
body[data-theme="dark"] .clay-textarea::selection{background:rgba(255,255,255,0.15)}

.clay-actions{
  display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;align-items:center;
}
.clay-hint{
  font-size:.75rem;color:var(--text-muted);margin-top:14px;
  line-height:1.5;
}
.clay-empty{
  text-align:center;padding:28px 14px;
  color:var(--text-muted);font-size:.875rem;font-weight:500;
}

/* ── Responsive ────────────────────────────────────────────── */
@media(max-width:768px){
  .app{padding:16px 14px 40px}
  .stats-bar{grid-template-columns:1fr 1fr;gap:10px}
