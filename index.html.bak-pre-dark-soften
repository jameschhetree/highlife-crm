<script>
/* ══════════════════════════════════════════════════════════════
   THEME
   ══════════════════════════════════════════════════════════════ */
function getStoredTheme() {
  return localStorage.getItem('theme') || 'dark';
}

function applyTheme(theme) {
  if (theme === 'dark') {
    document.body.setAttribute('data-theme', 'dark');
    startStarfield();
  } else {
    document.body.removeAttribute('data-theme');
    stopStarfield();
  }
}

function toggleTheme() {
  const current = document.body.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  const next = current === 'dark' ? 'light' : 'dark';
  localStorage.setItem('theme', next);
  applyTheme(next);
}

if (getStoredTheme() === 'dark') {
  document.body.setAttribute('data-theme', 'dark');
}

/* ══════════════════════════════════════════════════════════════
   STARFIELD
   ══════════════════════════════════════════════════════════════ */
const starCanvas = document.getElementById('starfield');
const starCtx = starCanvas.getContext('2d');
let starAnimId = null;
let stars = [];
const STAR_COUNT = 220;
const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function initStars() {
  stars = [];
  const w = starCanvas.width = window.innerWidth;
  const h = starCanvas.height = window.innerHeight;
  for (let i = 0; i < STAR_COUNT; i++) {
    const layer = Math.random() < 0.5 ? 0 : (Math.random() < 0.7 ? 1 : 2);
    stars.push({
      x: Math.random() * w,
      y: Math.random() * h,
      r: 0.4 + Math.random() * (layer === 2 ? 1.6 : layer === 1 ? 1.0 : 0.5),
      layer: layer,
      speed: 0.04 + layer * 0.03,
      twinklePhase: Math.random() * Math.PI * 2,
      twinkleSpeed: 0.003 + Math.random() * 0.006,
      drift: (Math.random() - 0.5) * 0.015,
    });
  }
}

function drawStars(timestamp) {
  const w = starCanvas.width;
  const h = starCanvas.height;
  starCtx.clearRect(0, 0, w, h);

  for (const s of stars) {
    if (!prefersReduced) {
      s.twinklePhase += s.twinkleSpeed;
      s.y -= s.speed;
      s.x += s.drift;
      if (s.y < -2) { s.y = h + 2; s.x = Math.random() * w; }
      if (s.x < -2) s.x = w + 2;
      if (s.x > w + 2) s.x = -2;
    }

    const alpha = 0.35 + 0.55 * (0.5 + 0.5 * Math.sin(s.twinklePhase));
    starCtx.beginPath();
    starCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    starCtx.fillStyle = `rgba(255,255,255,${alpha})`;
    starCtx.fill();
  }

  starAnimId = requestAnimationFrame(drawStars);
}

function startStarfield() {
  if (starAnimId) return;
  initStars();
  starAnimId = requestAnimationFrame(drawStars);
}

function stopStarfield() {
  if (starAnimId) {
    cancelAnimationFrame(starAnimId);
    starAnimId = null;
  }
  starCtx.clearRect(0, 0, starCanvas.width, starCanvas.height);
}

window.addEventListener('resize', function() {
  if (document.body.getAttribute('data-theme') === 'dark') {
    starCanvas.width = window.innerWidth;
    starCanvas.height = window.innerHeight;
    initStars();
  }
});

if (document.body.getAttribute('data-theme') === 'dark') {
  startStarfield();
}

/* ══════════════════════════════════════════════════════════════
   VIEW TOGGLE
   ══════════════════════════════════════════════════════════════ */
let currentView = localStorage.getItem('hl_crm_view') || 'clients';

function switchView(view) {
  currentView = view;
  localStorage.setItem('hl_crm_view', view);
  document.querySelectorAll('.view-toggle-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.view === view);
  });
  document.getElementById('clientsView').style.display = view === 'clients' ? '' : 'none';
  document.getElementById('agencyView').style.display = view === 'agency' ? '' : 'none';
  // Glassmorphic mesh-gradient backdrop active on prospects (clients) view.
  // The glass design ships in BOTH light and dark variants (James greenlight
  // 2026-05-18 Telegram #3113/#3115 — "make it black since background is on
  // white for dark mode then light mode for what you have now"). Respect the
  // user's saved theme on every view; only the glass-bg flag differs.
  const savedTheme = localStorage.getItem('theme') || 'dark';
  if (view === 'clients') {
    document.body.setAttribute('data-glass-bg', '1');
  } else {
    document.body.setAttribute('data-glass-bg', '0');
  }
  if (savedTheme === 'dark') {
    document.body.setAttribute('data-theme', 'dark');
    if (typeof startStarfield === 'function') startStarfield();
  } else {
    document.body.removeAttribute('data-theme');
    if (typeof stopStarfield === 'function') stopStarfield();
  }
  if (view === 'agency') {
    renderAgencyBoard();
  } else {
    renderBoard();
  }
}

/* ══════════════════════════════════════════════════════════════
   CLIENTS DATA
   ══════════════════════════════════════════════════════════════ */
const COLUMNS = [
  { id: 'prospect',       label: 'Prospect' },
  { id: 'added_to_crm',   label: 'Added to CRM' },
  { id: 'contacted',      label: 'Contacted' },
  { id: 'tour_booked',    label: 'Tour Booked' },
  { id: 'demo',           label: 'Demo' },
  { id: 'client',         label: 'Client' },
  { id: 'lost',           label: 'Lost' },
  { id: 'graveyard',      label: 'Graveyard' },
];

const PACKAGES = [
  { name: 'Hourly Rental',         price: 112, label: 'Hourly Rental ($75-150/hr)' },
  { name: 'Lunch & Record',        price: 300, label: 'Lunch & Record ($300)' },
  { name: 'Happy Hour Package',    price: 200, label: 'Happy Hour Package ($200)' },
  { name: 'Guest Spot',            price: 500, label: 'Guest Spot ($500)' },
  { name: 'Podcast Launch Kit',    price: 2000, label: 'Podcast Launch Kit ($2,000)' },
  { name: 'Content Sprint',        price: 2500, label: 'Content Sprint ($2,500)' },
  { name: 'Monthly Creator',       price: 1500, label: 'Monthly Creator ($1,500/mo)' },
  { name: 'CEO Brand Suite',       price: 4000, label: 'CEO Brand Suite ($4,000)' },
  { name: 'Thought Leader Series', price: 5000, label: 'Thought Leader Series ($5,000)' },
  { name: 'Political Roundtable',  price: 3000, label: 'Political Roundtable ($3,000)' },
  { name: 'Campaign Package',      price: 5000, label: 'Campaign Package ($5,000)' },
  { name: 'Managed Podcast',       price: 3000, label: 'Managed Podcast ($3,000/mo)' },
  { name: 'Studio Membership',     price: 500, label: 'Studio Membership ($500/mo)' },
];

const STORAGE_KEY = 'highlife_crm_prospects';

function loadProspects() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
  catch { return []; }
}
function saveProspects(data) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}
function genId() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 8); }

/* ── Seed data loader ── */
async function loadSeedData() {
  try {
    const res = await fetch('prospects.json');
    if (!res.ok) return;
    const seed = await res.json();
    const existing = loadProspects();
    const existingById = new Map(existing.map(p => [p.id, p]));
    let added = 0;
    let backfilled = 0;
    const backfillFields = ['email', 'phone'];
    seed.forEach(p => {
      const current = existingById.get(p.id);
      if (!current) {
        existing.push(p);
        added++;
      } else {
        backfillFields.forEach(f => {
          if (!current[f] && p[f]) {
            current[f] = p[f];
            backfilled++;
          }
        });
      }
    });
    if (added > 0 || backfilled > 0) {
      saveProspects(existing);
      renderBoard();
    }
  } catch (e) {}
}

/* ── Init dropdowns ── */
function initDropdowns() {
  const pkgSelect = document.getElementById('f-package');
  const filterPkg = document.getElementById('filterPackage');
  PACKAGES.forEach(p => {
    pkgSelect.innerHTML += `<option value="${p.name}">${p.label}</option>`;
    filterPkg.innerHTML += `<option value="${p.name}">${p.name}</option>`;
  });
}

/* ── Stats ── */
function updateStats() {
  const all = loadProspects();
  const pipeline = all.filter(p => !['client','lost','graveyard'].includes(p.status));
  const converted = all.filter(p => p.status === 'client');
  const revenue = all.filter(p => !['lost','graveyard'].includes(p.status)).reduce((sum, p) => {
    const pkg = PACKAGES.find(pk => pk.name === p.package);
    return sum + (pkg ? pkg.price : 0);
  }, 0);
  document.getElementById('stat-total').textContent = all.length;
  document.getElementById('stat-pipeline').textContent = pipeline.length;
  document.getElementById('stat-converted').textContent = converted.length;
  document.getElementById('stat-revenue').textContent = '$' + revenue.toLocaleString();
}

/* ── Render Board ── */
function renderBoard() {
  const board = document.getElementById('board');
  const all = loadProspects();
  const search = document.getElementById('searchInput').value.toLowerCase();
  const filterStatus = document.getElementById('filterStatus').value;
  const filterPkg = document.getElementById('filterPackage').value;

  let filtered = all;
  if (search) filtered = filtered.filter(p =>
    (p.name || '').toLowerCase().includes(search) ||
    (p.company || '').toLowerCase().includes(search) ||
    (p.email || '').toLowerCase().includes(search)
  );
  if (filterStatus) filtered = filtered.filter(p => p.status === filterStatus);
  if (filterPkg) filtered = filtered.filter(p => p.package === filterPkg);

  board.innerHTML = COLUMNS.map(col => {
    const cards = filtered.filter(p => p.status === col.id);
    const colClass = col.id === 'graveyard' ? 'column graveyard-col' : 'column';
    return `
      <div class="${colClass}">
        <div class="column-header">
          <span class="column-title">${col.label}</span>
          <span class="column-count">${cards.length}</span>
        </div>
        <div class="column-body" data-status="${col.id}"
             ondragover="handleDragOver(event)"
             ondragenter="handleDragEnter(event)"
             ondragleave="handleDragLeave(event)"
             ondrop="handleDrop(event)">
          ${cards.length ? cards.map(cardHTML).join('') : '<div class="empty-col">No prospects</div>'}
        </div>
      </div>`;
  }).join('');
  updateStats();
  updateClayCount();
}

